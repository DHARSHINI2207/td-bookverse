# ---------------------------------------------------------------------------
# T&D BookVerse — root environment example.
# Copy this file to .env at the repo root (used by docker-compose) and also
# copy the relevant values into apps/api/.env and apps/web/.env for local dev.
# ---------------------------------------------------------------------------

# Postgres (used by docker-compose + Prisma)
POSTGRES_USER=bookverse
POSTGRES_PASSWORD=bookverse_password
POSTGRES_DB=bookverse
POSTGRES_PORT=5433

# Full connection string Prisma uses. Host is "postgres" inside docker-compose,
# "localhost" when running the API directly on your machine.
DATABASE_URL=postgresql://bookverse:bookverse_password@localhost:5432/bookverse?schema=public

# API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Web
VITE_API_URL=http://localhost:4000/api
